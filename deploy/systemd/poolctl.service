[Unit]
Description=pool automation controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pool/projects/pool
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pool/projects/pool/venv/bin/python -m poolctl.web.server --config /home/pool/projects/pool/configs/pi-prod.yaml --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
