[Unit]
Description=poolctl tick driver (continuous /api/live polling)
After=poolctl.service
Requires=poolctl.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__PROJECT_DIR__
ExecStart=/bin/bash -lc 'while true; do curl -fsS http://127.0.0.1:__WEB_PORT__/api/live >/dev/null || true; sleep 1; done'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
